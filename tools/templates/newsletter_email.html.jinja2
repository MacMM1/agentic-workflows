<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
<style>
  body { margin: 0; padding: 0; background-color: #f9f9f7; font-family: Arial, Helvetica, sans-serif; }
  .wrapper { width: 100%; background-color: #f9f9f7; }
  .container { width: 600px; max-width: 600px; background-color: #ffffff; }
  .headline { font-size: 24px; line-height: 32px; color: #0b0b0b; font-weight: bold; padding: 24px 24px 8px 24px; }
  .section-heading { font-size: 18px; line-height: 26px; color: #0b0b0b; font-weight: bold; padding: 20px 24px 4px 24px; }
  .body-text { font-size: 15px; line-height: 22px; color: #33322f; padding: 0 24px; }
  .chart-caption { font-size: 12px; line-height: 18px; color: #898781; padding: 4px 24px 0 24px; }
  .sources-heading { font-size: 14px; line-height: 20px; color: #898781; font-weight: bold; padding: 24px 24px 4px 24px; text-transform: uppercase; }
  .source-item { font-size: 13px; line-height: 20px; color: #52514e; padding: 2px 24px; }
  .source-item a { color: #2a78d6; }
  .footer { font-size: 11px; line-height: 16px; color: #898781; padding: 20px 24px; text-align: center; }
</style>
</head>
<body>
  <span style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{ preheader }}</span>
  <table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" align="center">
          <tr>
            <td class="headline">{{ headline }}</td>
          </tr>
          {% for section in sections %}
          <tr>
            <td class="section-heading">{{ section.heading }}</td>
          </tr>
          <tr>
            <td class="body-text">{{ section.body }}</td>
          </tr>
          {% if section.chart_ref and section.chart_ref in charts_by_id %}
          {% set chart = charts_by_id[section.chart_ref] %}
          <tr>
            <td style="padding: 12px 24px 0 24px;" align="center">
              <img src="cid:{{ chart.id }}@newsletter.local" width="560" height="312" alt="{{ chart.title }}" style="display:block; width:100%; max-width:560px; height:auto; border:0;">
            </td>
          </tr>
          {% if chart.note %}
          <tr>
            <td class="chart-caption">{{ chart.note }}</td>
          </tr>
          {% endif %}
          {% endif %}
          {% endfor %}
          {% if sources %}
          <tr>
            <td class="sources-heading">Sources</td>
          </tr>
          {% for source in sources %}
          <tr>
            <td class="source-item">&bull; <a href="{{ source.url }}">{{ source.title }}</a></td>
          </tr>
          {% endfor %}
          {% endif %}
          <tr>
            <td class="footer">Generated by your newsletter automation workflow.</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
